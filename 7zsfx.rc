/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_DIALOG_MAIN DIALOGEX 0, 0, 339, 106
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_MINIMIZEBOX | WS_POPUP | 
    WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_ACCEPTFILES
CAPTION "7z self-extracting file creator"
FONT 9, "宋体", 0, 0, 0x1
BEGIN
    LTEXT           "Path to &compress",IDC_STATIC,7,10,82,8
    EDITTEXT        IDC_EDIT_SOURCE,92,7,187,14,ES_AUTOHSCROLL
    PUSHBUTTON      "&Browse...",IDC_BUTTON_BROWSE,282,7,50,14
    LTEXT           "Dialog &title",IDC_STATIC,7,26,82,8
    EDITTEXT        IDC_EDIT_TITLE,92,23,240,14,ES_AUTOHSCROLL
    LTEXT           "Dialog &main text",IDC_STATIC,7,42,82,8
    EDITTEXT        IDC_EDIT_MESSAGE,92,39,240,14,ES_AUTOHSCROLL
    LTEXT           "&Run after extracting",IDC_STATIC,7,57,82,8
    COMBOBOX        IDC_COMBO_RUN,92,55,240,221,CBS_DROPDOWN | 
                    CBS_AUTOHSCROLL | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Path or parameter",IDC_STATIC_PARAMETER,7,72,82,8
    EDITTEXT        IDC_EDIT_RUN_PATH,92,69,240,14,ES_AUTOHSCROLL
    CONTROL         "&Show progress",IDC_CHECK_PROGRESS,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,7,87,82,10
    CONTROL         "Locat&e output file",IDC_CHECK_LOCATE,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,92,87,98,10
    CONTROL         "Need &administrator",IDC_CHECK_ADMIN,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,193,87,86,10
    DEFPUSHBUTTON   "&OK",IDOK,282,85,50,14
END


